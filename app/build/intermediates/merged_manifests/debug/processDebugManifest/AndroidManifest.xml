<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.cardmaster.app"
    android:versionCode="1"
    android:versionName="1.0" >

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="34" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <permission
        android:name="com.cardmaster.app.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.cardmaster.app.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:name="com.cardmaster.app.CardMasterApp"
        android:allowBackup="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:icon="@drawable/ic_style"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_style"
        android:supportsRtl="true"
        android:testOnly="true"
        android:theme="@style/Theme.CardMaster" >

        <!-- Splash Activity (Launcher) -->
        <activity
            android:name="com.cardmaster.app.ui.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.CardMaster" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Auth Activities -->
        <activity
            android:name="com.cardmaster.app.ui.auth.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.cardmaster.app.ui.auth.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.cardmaster.app.ui.auth.ForgotPasswordActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Main Tabbed Activity -->
        <activity
            android:name="com.cardmaster.app.ui.main.MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan" />

        <!-- Deck & Card Activities -->
        <activity
            android:name="com.cardmaster.app.ui.deck.DeckDetailActivity"
            android:exported="false" />
        <activity
            android:name="com.cardmaster.app.ui.card.CardEditorActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Study Activities -->
        <activity
            android:name="com.cardmaster.app.ui.study.FlashcardStudyActivity"
            android:exported="false" />

        <!-- Quiz Activities -->
        <activity
            android:name="com.cardmaster.app.ui.quiz.QuizSetupActivity"
            android:exported="false" />
        <activity
            android:name="com.cardmaster.app.ui.quiz.QuizPlayActivity"
            android:exported="false" />
        <activity
            android:name="com.cardmaster.app.ui.quiz.QuizResultActivity"
            android:exported="false" />

        <!-- Import / Export Activities -->
        <activity
            android:name="com.cardmaster.app.ui.impexp.ImportActivity"
            android:exported="false" />

        <!-- AI Document Activities -->
        <activity
            android:name="com.cardmaster.app.ui.ai.AiDocumentActivity"
            android:exported="false" />

        <!-- Study Planner Activities -->
        <activity
            android:name="com.cardmaster.app.ui.planner.StudyPlannerActivity"
            android:exported="false" />

        <!-- Notification Activities -->
        <activity
            android:name="com.cardmaster.app.ui.notification.NotificationActivity"
            android:exported="false" />

        <!-- Profile Sub-Activities -->
        <activity
            android:name="com.cardmaster.app.ui.main.profile.EditProfileActivity"
            android:exported="false" />
        <activity
            android:name="com.cardmaster.app.ui.main.profile.ChangePasswordActivity"
            android:exported="false" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.cardmaster.app.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup" />
        </provider>

        <service
            android:name="androidx.room.MultiInstanceInvalidationService"
            android:directBootAware="true"
            android:exported="false" />

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" >
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>