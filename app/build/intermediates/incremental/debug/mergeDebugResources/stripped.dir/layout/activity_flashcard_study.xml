<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding">

    <!-- Top Bar: Back & Progress Indicator -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/color_text_primary" />

        <TextView
            android:id="@+id/tvProgressCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="1 / 10"
            android:textColor="@color/color_text_primary"
            android:textSize="@dimen/text_title_medium"
            android:textStyle="bold" />
    </RelativeLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/progress_bar_height"
        android:layout_marginTop="@dimen/space_12"
        android:progress="10"
        app:indicatorColor="@color/color_primary"
        app:trackColor="@color/color_surface_variant"
        app:trackCornerRadius="999dp" />

    <!-- 3D Flippable Flashcard -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_24"
        android:layout_weight="1">

        <com.cardmaster.app.ui.view.FlipCardView
            android:id="@+id/flipCardView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:minHeight="@dimen/flashcard_min_height">

            <!-- FRONT OF CARD -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFront"
                style="@style/Widget.CardMaster.Flashcard"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="@dimen/space_24">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentStart="true"
                        android:background="@drawable/bg_badge_info"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="CÂU HỎI / THUẬT NGỮ"
                        android:textColor="@color/color_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvFrontText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:gravity="center"
                        android:text="Room Persistence Library là gì?"
                        android:textColor="@color/color_text_primary"
                        android:textSize="@dimen/text_headline_medium"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:layout_centerHorizontal="true"
                        android:text="Chạm vào thẻ hoặc bấm nút bên dưới để lật"
                        android:textColor="@color/color_text_disabled"
                        android:textSize="@dimen/text_body_small" />
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- BACK OF CARD -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBack"
                style="@style/Widget.CardMaster.Flashcard"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="@dimen/space_24">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentStart="true"
                        android:background="@drawable/bg_badge_success"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="ĐÁP ÁN"
                        android:textColor="@color/color_on_success_container"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvBackText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:gravity="center"
                        android:lineSpacingExtra="4dp"
                        android:text="Room là một thư viện cung cấp một lớp trừu tượng (abstraction layer) trên SQLite..."
                        android:textColor="@color/color_text_primary"
                        android:textSize="@dimen/text_body_large" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:layout_centerHorizontal="true"
                        android:text="Hãy đánh giá mức độ ghi nhớ của bạn"
                        android:textColor="@color/color_text_disabled"
                        android:textSize="@dimen/text_body_small" />
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>
        </com.cardmaster.app.ui.view.FlipCardView>
    </FrameLayout>

    <!-- Bottom Actions -->
    <LinearLayout
        android:id="@+id/llFlipAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_24"
        android:visibility="visible">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFlipCard"
            style="@style/Widget.CardMaster.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:text="@string/btn_flip_card"
            app:icon="@drawable/ic_flip"
            app:iconGravity="textStart"
            app:iconSize="20dp" />
    </LinearLayout>

    <!-- Post-Flip Actions: Chưa nhớ & Đã nhớ -->
    <LinearLayout
        android:id="@+id/llPostFlipActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_24"
        android:orientation="horizontal"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNotMemorized"
            style="@style/Widget.CardMaster.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_marginEnd="@dimen/space_8"
            android:layout_weight="1"
            android:backgroundTint="@color/color_error_container"
            android:text="@string/btn_not_memorized"
            android:textColor="@color/color_on_error_container"
            app:icon="@drawable/ic_cancel"
            app:iconGravity="textStart"
            app:iconSize="20dp"
            app:iconTint="@color/color_on_error_container" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMemorized"
            style="@style/Widget.CardMaster.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_marginStart="@dimen/space_8"
            android:layout_weight="1"
            android:backgroundTint="@color/color_success_container"
            android:text="@string/btn_memorized"
            android:textColor="@color/color_on_success_container"
            app:icon="@drawable/ic_check_circle"
            app:iconGravity="textStart"
            app:iconSize="20dp"
            app:iconTint="@color/color_on_success_container" />
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="16dp" />
</LinearLayout>
