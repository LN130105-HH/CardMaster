<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <!-- Top Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="8dp"
                    android:src="@drawable/ic_arrow_back"
                    android:tint="@color/color_text_primary" />

                <TextView
                    android:id="@+id/tvQuizProgressCounter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="Câu 1 / 10"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/text_title_medium"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_badge_warning"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="05:00"
                    android:textColor="@color/color_on_warning_container"
                    android:textSize="@dimen/text_label_small"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </RelativeLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressBar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/progress_bar_height"
                android:layout_marginTop="@dimen/space_12"
                android:progress="10"
                app:indicatorColor="@color/color_quiz"
                app:trackColor="@color/color_surface_variant"
                app:trackCornerRadius="999dp" />

            <!-- Question Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.CardMaster.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <TextView
                        android:id="@+id/tvQuestionBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_info"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="TRẮC NGHIỆM"
                        android:textColor="@color/color_quiz"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvQuestionText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:lineSpacingExtra="4dp"
                        android:text="Trong Room Database, annotation nào được dùng để đánh dấu một lớp là thực thể ánh xạ vào bảng SQLite?"
                        android:textColor="@color/color_text_primary"
                        android:textSize="@dimen/text_body_large"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 4 Options -->
            <LinearLayout
                android:id="@+id/llOptionsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:orientation="vertical">

                <!-- Option A -->
                <LinearLayout
                    android:id="@+id/cardOptionA"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_quiz_option_default"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/quiz_option_height"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/space_16"
                    android:paddingVertical="12dp">

                    <TextView
                        android:id="@+id/tvOptionPrefixA"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_badge_neutral"
                        android:gravity="center"
                        android:text="A"
                        android:textColor="@color/color_text_primary"
                        android:textSize="@dimen/text_label_large"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvOptionTextA"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:text="Quản lý giao diện"
                        android:textColor="@color/color_text_primary"
                        android:textSize="@dimen/text_body_medium" />
                </LinearLayout>

                <!-- Option B -->
                <LinearLayout
                    android:id="@+id/cardOptionB"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:background="@drawable/bg_quiz_option_default"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/quiz_option_height"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/space_16"
                    android:paddingVertical="12dp">

                    <TextView
                        android:id="@+id/tvOptionPrefixB"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_badge_neutral"
                        android:gravity="center"
                        android:text="B"
                        android:textColor="@color/color_text_primary"
                        android:textSize="@dimen/text_label_large"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvOptionTextB"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:text="Lưu trữ dữ liệu SQLite"
                        android:textColor="@color/color_text_primary"
                        android:textSize="@dimen/text_body_medium" />
                </LinearLayout>

                <!-- Option C -->
                <LinearLayout
                    android:id="@+id/cardOptionC"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:background="@drawable/bg_quiz_option_default"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/quiz_option_height"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/space_16"
                    android:paddingVertical="12dp">

                    <TextView
                        android:id="@+id/tvOptionPrefixC"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_badge_neutral"
                        android:gravity="center"
                        android:text="C"
                        android:textColor="@color/color_text_primary"
                        android:textSize="@dimen/text_label_large"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvOptionTextC"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:text="Quản lý mạng HTTP"
                        android:textColor="@color/color_text_primary"
                        android:textSize="@dimen/text_body_medium" />
                </LinearLayout>

                <!-- Option D -->
                <LinearLayout
                    android:id="@+id/cardOptionD"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:background="@drawable/bg_quiz_option_default"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/quiz_option_height"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/space_16"
                    android:paddingVertical="12dp">

                    <TextView
                        android:id="@+id/tvOptionPrefixD"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_badge_neutral"
                        android:gravity="center"
                        android:text="D"
                        android:textColor="@color/color_text_primary"
                        android:textSize="@dimen/text_label_large"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvOptionTextD"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:text="Tất cả đều sai"
                        android:textColor="@color/color_text_primary"
                        android:textSize="@dimen/text_body_medium" />
                </LinearLayout>
            </LinearLayout>

            <!-- Explanation & Flip Card Section (After Answering) -->
            <LinearLayout
                android:id="@+id/llExplanationSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:orientation="vertical"
                android:visibility="gone">

                <com.cardmaster.app.ui.view.FlipCardView
                    android:id="@+id/flipExplanationView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- Front: Result Summary & Prompt to Flip -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardResultSummary"
                        style="@style/Widget.CardMaster.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/card_padding">

                            <TextView
                                android:id="@+id/tvResultStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Chính xác ✓"
                                android:textColor="@color/color_success"
                                android:textSize="@dimen/text_title_large"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvUserChoiceSummary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Bạn đã chọn: B. Lưu trữ dữ liệu SQLite"
                                android:textColor="@color/color_text_secondary"
                                android:textSize="@dimen/text_body_medium" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnFlipToSeeExplanation"
                                style="@style/Widget.CardMaster.Button.Secondary"
                                android:layout_width="match_parent"
                                android:layout_height="46dp"
                                android:layout_marginTop="@dimen/space_12"
                                android:minHeight="46dp"
                                android:text="@string/btn_flip_explanation"
                                app:icon="@drawable/ic_flip"
                                app:iconGravity="textStart"
                                app:iconSize="18dp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Back: Detailed Explanation & Source info -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardDetailedExplanation"
                        style="@style/Widget.CardMaster.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="@color/color_surface_variant">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/card_padding">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="GIẢI THÍCH CHI TIẾT"
                                android:textColor="@color/color_primary"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvExplanationText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:lineSpacingExtra="3dp"
                                android:text="Room là thư viện lưu trữ cung cấp một lớp trừu tượng trên SQLite..."
                                android:textColor="@color/color_text_primary"
                                android:textSize="@dimen/text_body_medium" />

                            <TextView
                                android:id="@+id/tvSourceInfo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Nguồn: Trang 12 — Android_Room_Guide.pdf"
                                android:textColor="@color/color_text_secondary"
                                android:textSize="@dimen/text_body_small"
                                android:textStyle="italic"
                                android:visibility="visible" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </com.cardmaster.app.ui.view.FlipCardView>
            </LinearLayout>

            <!-- Bottom Buttons: Bỏ qua & Tiếp theo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSkipQuestion"
                    style="@style/Widget.CardMaster.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginEnd="@dimen/space_4"
                    android:layout_weight="1"
                    android:text="@string/btn_skip_question"
                    android:textColor="@color/color_text_secondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNextQuestion"
                    style="@style/Widget.CardMaster.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginStart="@dimen/space_4"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="@string/btn_next_question" />
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="40dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
