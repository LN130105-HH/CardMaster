<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <!-- Top Bar -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="8dp"
                    android:src="@drawable/ic_arrow_back"
                    android:tint="@color/color_text_primary" />

                <TextView
                    android:id="@+id/tvHeaderTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/space_8"
                    android:layout_toEndOf="@+id/btnBack"
                    android:layout_toStartOf="@+id/btnDeckMenu"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Chi tiết bộ thẻ"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/text_title_large"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/btnDeckMenu"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="8dp"
                    android:src="@drawable/ic_more_vert"
                    android:tint="@color/color_text_primary" />
            </RelativeLayout>

            <!-- Deck Overview Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.CardMaster.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <TextView
                        android:id="@+id/tvDeckName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Room &amp; SQLite trong Android"
                        android:textColor="@color/color_text_primary"
                        android:textSize="@dimen/text_headline_medium"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSubject"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Lập trình di động"
                        android:textColor="@color/color_text_secondary"
                        android:textSize="@dimen/text_body_medium" />

                    <TextView
                        android:id="@+id/tvDeckDescription"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:text="Ôn tập kiến thức Room persistence library và SQLite"
                        android:textColor="@color/color_text_secondary"
                        android:textSize="@dimen/text_body_small" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="@dimen/space_12"
                        android:background="@color/color_divider" />

                    <!-- Counts -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="3">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvTotalCardsCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/color_text_primary"
                                android:textSize="@dimen/text_title_large"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tổng số thẻ"
                                android:textColor="@color/color_text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvFlashcardCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/color_flashcard"
                                android:textSize="@dimen/text_title_large"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Flashcards"
                                android:textColor="@color/color_text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvQuizCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/color_quiz"
                                android:textSize="@dimen/text_title_large"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Quiz Cards"
                                android:textColor="@color/color_text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Main Actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStudy"
                    style="@style/Widget.CardMaster.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginEnd="@dimen/space_4"
                    android:layout_weight="1"
                    android:text="Học Flashcard"
                    app:icon="@drawable/ic_style"
                    app:iconSize="18dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnQuiz"
                    style="@style/Widget.CardMaster.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginStart="@dimen/space_4"
                    android:layout_weight="1"
                    android:text="Làm Quiz"
                    app:icon="@drawable/ic_quiz"
                    app:iconSize="18dp" />
            </LinearLayout>

            <!-- Sub Action Icons: Add, Import, AI, Schedule, Export -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddCard"
                    style="@style/Widget.CardMaster.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:paddingHorizontal="4dp"
                    android:text="+ Thẻ"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnImport"
                    style="@style/Widget.CardMaster.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:paddingHorizontal="4dp"
                    android:text="Nhập"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAiCreate"
                    style="@style/Widget.CardMaster.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:paddingHorizontal="4dp"
                    android:text="AI"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExport"
                    style="@style/Widget.CardMaster.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:paddingHorizontal="4dp"
                    android:text="Xuất"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSchedule"
                    style="@style/Widget.CardMaster.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:paddingHorizontal="4dp"
                    android:text="Lịch"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Filter Tabs -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_20"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tabAllCards"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_chip_selected"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="Tất cả"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_label_small" />

                <TextView
                    android:id="@+id/tabFlashcards"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="@dimen/space_8"
                    android:background="@drawable/bg_chip_unselected"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="Flashcards"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="@dimen/text_label_small" />

                <TextView
                    android:id="@+id/tabQuizCards"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="@dimen/space_8"
                    android:background="@drawable/bg_chip_unselected"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="Quiz Cards"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="@dimen/text_label_small" />
            </LinearLayout>

            <!-- Cards List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:nestedScrollingEnabled="false" />

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/llEmptyCards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_32"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_style"
                    android:tint="@color/color_outline" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:text="Chưa có thẻ trong bộ này"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/text_title_medium"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Thêm thẻ thủ công, nhập file hoặc tạo bằng AI."
                    android:textColor="@color/color_text_secondary"
                    android:textSize="@dimen/text_body_medium" />
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="40dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
