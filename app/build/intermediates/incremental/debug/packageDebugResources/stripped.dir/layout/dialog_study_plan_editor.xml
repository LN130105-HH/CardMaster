<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bộ thẻ ôn tập:"
        android:textColor="@color/color_text_secondary"
        android:textSize="@dimen/text_label_medium" />

    <Spinner
        android:id="@+id/spPlanDeck"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_quiz_option_default" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:text="Thời gian ôn tập:"
        android:textColor="@color/color_text_secondary"
        android:textSize="@dimen/text_label_medium" />

    <TextView
        android:id="@+id/tvSelectDateTime"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_quiz_option_default"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/space_12"
        android:text="Chọn ngày &amp; giờ"
        android:textColor="@color/color_text_primary"
        android:textSize="@dimen/text_body_medium" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:text="Tần suất lặp lại:"
        android:textColor="@color/color_text_secondary"
        android:textSize="@dimen/text_label_medium" />

    <Spinner
        android:id="@+id/spRepeatMode"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_quiz_option_default" />

    <CheckBox
        android:id="@+id/cbRemind"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:checked="true"
        android:text="Bật nhắc nhở thông báo trước giờ học"
        android:textColor="@color/color_text_primary" />
</LinearLayout>
