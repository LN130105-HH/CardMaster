<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chọn môn học:"
        android:textColor="@color/color_text_secondary"
        android:textSize="@dimen/text_label_medium" />

    <Spinner
        android:id="@+id/spSubjects"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_quiz_option_default" />

    <EditText
        android:id="@+id/etDeckTitle"
        android:layout_width="match_parent"
        android:layout_height="@dimen/input_height"
        android:layout_marginTop="@dimen/space_12"
        android:background="@drawable/bg_quiz_option_default"
        android:hint="Tên bộ thẻ"
        android:paddingHorizontal="@dimen/space_16"
        android:textColor="@color/color_text_primary"
        android:textSize="@dimen/text_body_medium" />

    <EditText
        android:id="@+id/etDeckDesc"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginTop="@dimen/space_12"
        android:background="@drawable/bg_quiz_option_default"
        android:gravity="top|start"
        android:hint="Mô tả bộ thẻ (tùy chọn)"
        android:padding="@dimen/space_12"
        android:textColor="@color/color_text_primary"
        android:textSize="@dimen/text_body_medium" />
</LinearLayout>
