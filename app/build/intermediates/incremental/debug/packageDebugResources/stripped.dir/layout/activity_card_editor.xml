<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <!-- Top Bar -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="8dp"
                    android:src="@drawable/ic_arrow_back"
                    android:tint="@color/color_text_primary" />

                <TextView
                    android:id="@+id/tvEditorTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/space_8"
                    android:layout_toEndOf="@+id/btnBack"
                    android:text="Thêm thẻ mới"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/text_title_large"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- Card Type Selector: Flashcard vs Quiz Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:background="@drawable/bg_quiz_option_default"
                android:padding="4dp">

                <TextView
                    android:id="@+id/btnTypeFlashcard"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_selected"
                    android:gravity="center"
                    android:text="Flashcard Ôn tập"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_label_large"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnTypeQuiz"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Quiz Card Trắc nghiệm"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="@dimen/text_label_large" />
            </LinearLayout>

            <!-- FLASHCARD FORM -->
            <LinearLayout
                android:id="@+id/llFlashcardForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mặt trước (Câu hỏi / Thuật ngữ):"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="@dimen/text_label_medium"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etFlashcardFront"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_quiz_option_default"
                    android:gravity="top|start"
                    android:hint="Nhập câu hỏi hoặc khái niệm..."
                    android:padding="@dimen/space_12"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/text_body_large" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:text="Mặt sau (Đáp án / Giải thích):"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="@dimen/text_label_medium"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etFlashcardBack"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_quiz_option_default"
                    android:gravity="top|start"
                    android:hint="Nhập câu trả lời hoặc nội dung chi tiết..."
                    android:padding="@dimen/space_12"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/text_body_large" />
            </LinearLayout>

            <!-- QUIZ CARD FORM -->
            <LinearLayout
                android:id="@+id/llQuizForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Câu hỏi trắc nghiệm:"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="@dimen/text_label_medium"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etQuizQuestion"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_quiz_option_default"
                    android:gravity="top|start"
                    android:hint="Nhập câu hỏi trắc nghiệm..."
                    android:padding="@dimen/space_12"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/text_body_large" />

                <!-- 4 Options with Radio check for correct answer -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:text="Các phương án (Tích chọn đáp án đúng):"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="@dimen/text_label_medium"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgCorrectAnswer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp">

                    <!-- Option A -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/rbOptionA"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="A"
                            android:textColor="@color/color_text_primary"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/etOptionA"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/quiz_option_height"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_quiz_option_default"
                            android:hint="Nội dung đáp án A"
                            android:paddingHorizontal="@dimen/space_12"
                            android:textColor="@color/color_text_primary"
                            android:textSize="@dimen/text_body_medium" />
                    </LinearLayout>

                    <!-- Option B -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/rbOptionB"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="B"
                            android:textColor="@color/color_text_primary"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/etOptionB"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/quiz_option_height"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_quiz_option_default"
                            android:hint="Nội dung đáp án B"
                            android:paddingHorizontal="@dimen/space_12"
                            android:textColor="@color/color_text_primary"
                            android:textSize="@dimen/text_body_medium" />
                    </LinearLayout>

                    <!-- Option C -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/rbOptionC"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="C"
                            android:textColor="@color/color_text_primary"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/etOptionC"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/quiz_option_height"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_quiz_option_default"
                            android:hint="Nội dung đáp án C"
                            android:paddingHorizontal="@dimen/space_12"
                            android:textColor="@color/color_text_primary"
                            android:textSize="@dimen/text_body_medium" />
                    </LinearLayout>

                    <!-- Option D -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/rbOptionD"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="D"
                            android:textColor="@color/color_text_primary"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/etOptionD"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/quiz_option_height"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_quiz_option_default"
                            android:hint="Nội dung đáp án D"
                            android:paddingHorizontal="@dimen/space_12"
                            android:textColor="@color/color_text_primary"
                            android:textSize="@dimen/text_body_medium" />
                    </LinearLayout>
                </RadioGroup>

                <!-- Explanation -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:text="Giải thích đáp án (khi lật thẻ):"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="@dimen/text_label_medium"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etQuizExplanation"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_quiz_option_default"
                    android:gravity="top|start"
                    android:hint="Nhập lý do tại sao đáp án trên là đúng..."
                    android:padding="@dimen/space_12"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/text_body_medium" />

                <!-- Optional Source Information -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:text="Thông tin nguồn tài liệu (Tùy chọn):"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="@dimen/text_label_medium"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etSourceFile"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_quiz_option_default"
                    android:hint="Tên file tài liệu (ví dụ: Bai_giang_Room.pdf)"
                    android:paddingHorizontal="@dimen/space_12"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/text_body_small" />

                <EditText
                    android:id="@+id/etSourcePage"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_quiz_option_default"
                    android:hint="Trang hoặc đoạn (ví dụ: Trang 15)"
                    android:paddingHorizontal="@dimen/space_12"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/text_body_small" />
            </LinearLayout>

            <!-- Buttons: Lưu & Lưu & Tạo tiếp -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveAndCreateNext"
                    style="@style/Widget.CardMaster.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginEnd="@dimen/space_4"
                    android:layout_weight="1"
                    android:text="Lưu &amp; Tạo tiếp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveCard"
                    style="@style/Widget.CardMaster.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginStart="@dimen/space_4"
                    android:layout_weight="1"
                    android:text="Lưu thẻ" />
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="40dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
