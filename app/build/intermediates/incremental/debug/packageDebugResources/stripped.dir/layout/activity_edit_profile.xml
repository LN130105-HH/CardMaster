<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/color_text_primary" />

        <!-- Header: Title on Left, Circular Avatar on Right (as per section 3.2) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@+id/llAvatarContainer"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chỉnh sửa hồ sơ"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/text_headline_large"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Cập nhật thông tin tài khoản CardMaster"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="@dimen/text_body_small" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llAvatarContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center"
                android:orientation="vertical">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivAvatarPreview"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_badge_info"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_person"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                    app:strokeColor="@color/color_primary"
                    app:strokeWidth="2dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Đổi ảnh"
                    android:textColor="@color/color_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Name Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilName"
            style="@style/Widget.CardMaster.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20"
            android:hint="@string/full_name_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName"
                android:textColor="@color/color_text_primary"
                android:textSize="@dimen/text_body_large" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Email Input (Read only) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEmail"
            style="@style/Widget.CardMaster.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:enabled="false"
            android:hint="@string/email_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress"
                android:textColor="@color/color_text_disabled"
                android:textSize="@dimen/text_body_large" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Gender Section (Section 3.3) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:text="Giới tính (*):"
            android:textColor="@color/color_text_primary"
            android:textSize="@dimen/text_label_large"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgGender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbGenderMale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nam"
                android:textColor="@color/color_text_primary"
                android:textSize="@dimen/text_body_medium" />

            <RadioButton
                android:id="@+id/rbGenderFemale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nữ"
                android:textColor="@color/color_text_primary"
                android:textSize="@dimen/text_body_medium" />

            <RadioButton
                android:id="@+id/rbGenderOther"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Khác"
                android:textColor="@color/color_text_primary"
                android:textSize="@dimen/text_body_medium" />

            <RadioButton
                android:id="@+id/rbGenderUndisclosed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Không muốn cung cấp"
                android:textColor="@color/color_text_primary"
                android:textSize="@dimen/text_body_medium" />
        </RadioGroup>

        <TextView
            android:id="@+id/tvGenderError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Vui lòng chọn giới tính"
            android:textColor="@color/color_error"
            android:textSize="@dimen/text_body_small"
            android:visibility="gone" />

        <!-- Date of Birth Section (Section 3.4) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:text="Ngày tháng năm sinh:"
            android:textColor="@color/color_text_primary"
            android:textSize="@dimen/text_label_large"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/btnPickDob"
            android:layout_width="match_parent"
            android:layout_height="@dimen/input_height"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_quiz_option_default"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/space_16">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_event"
                android:tint="@color/color_primary" />

            <TextView
                android:id="@+id/tvSelectedDob"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_12"
                android:layout_weight="1"
                android:text="15/08/2003"
                android:textColor="@color/color_text_primary"
                android:textSize="@dimen/text_body_medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chọn ngày"
                android:textColor="@color/color_primary"
                android:textSize="@dimen/text_label_medium"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDobError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Ngày sinh không được ở tương lai"
            android:textColor="@color/color_error"
            android:textSize="@dimen/text_body_small"
            android:visibility="gone" />

        <!-- Save Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            style="@style/Widget.CardMaster.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_24"
            android:text="Lưu thay đổi" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="32dp" />
    </LinearLayout>
</ScrollView>
