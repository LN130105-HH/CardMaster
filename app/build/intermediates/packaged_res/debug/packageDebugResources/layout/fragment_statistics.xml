<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:text="Thống kê học tập"
            android:textColor="@color/color_text_primary"
            android:textSize="@dimen/text_headline_large"
            android:textStyle="bold" />

        <!-- Filter Chips: Today, 7 days, 30 days, All -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipToday"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="@string/filter_today"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="@dimen/text_label_large" />

                <TextView
                    android:id="@+id/chip7Days"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="@dimen/space_8"
                    android:background="@drawable/bg_chip_selected"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="@string/filter_7_days"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_label_large" />

                <TextView
                    android:id="@+id/chip30Days"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="@dimen/space_8"
                    android:background="@drawable/bg_chip_unselected"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="@string/filter_30_days"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="@dimen/text_label_large" />

                <TextView
                    android:id="@+id/chipAll"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="@dimen/space_8"
                    android:background="@drawable/bg_chip_unselected"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="@string/filter_all"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="@dimen/text_label_large" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Block 1: Study Time Statistics -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.CardMaster.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/study_time_title"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="@dimen/text_label_medium"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTotalStudyDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:text="0 phút"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/text_headline_medium"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStudySummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Trung bình 0 phút/phiên • 0 phiên học"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="@dimen/text_body_medium" />

                <com.cardmaster.app.ui.main.statistics.view.BarChartView
                    android:id="@+id/barChartView"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginTop="@dimen/space_16" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Block 2: Exercise & Quiz Results Donut Chart -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.CardMaster.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/quiz_stat_title"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="@dimen/text_label_medium"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Donut Chart -->
                    <com.cardmaster.app.ui.main.statistics.view.DonutChartView
                        android:id="@+id/donutChartView"
                        android:layout_width="160dp"
                        android:layout_height="160dp" />

                    <!-- Legend & Info -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_16"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:background="@color/color_success" />

                            <TextView
                                android:id="@+id/tvCorrectCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Đúng: 0 câu"
                                android:textColor="@color/color_text_primary"
                                android:textSize="@dimen/text_body_medium" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:background="@color/color_error" />

                            <TextView
                                android:id="@+id/tvWrongCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Sai: 0 câu"
                                android:textColor="@color/color_text_primary"
                                android:textSize="@dimen/text_body_medium" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:background="@color/color_surface_variant" />

                            <TextView
                                android:id="@+id/tvSkippedCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Bỏ qua: 0 câu"
                                android:textColor="@color/color_text_secondary"
                                android:textSize="@dimen/text_body_medium" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvQuizOverview"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="0 bài quiz đã hoàn thành\nĐiểm trung bình: 0%"
                            android:textColor="@color/color_text_secondary"
                            android:textSize="@dimen/text_body_small" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Block 3: Quiz History Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:text="Lịch sử làm bài trắc nghiệm"
            android:textColor="@color/color_text_primary"
            android:textSize="@dimen/text_title_large"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvQuizHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:nestedScrollingEnabled="false" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="40dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
