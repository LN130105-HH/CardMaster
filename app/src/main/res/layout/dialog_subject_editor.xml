<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <EditText
        android:id="@+id/etSubjectName"
        android:layout_width="match_parent"
        android:layout_height="@dimen/input_height"
        android:background="@drawable/bg_quiz_option_default"
        android:hint="Tên môn học / chủ đề"
        android:paddingHorizontal="@dimen/space_16"
        android:textColor="@color/color_text_primary"
        android:textSize="@dimen/text_body_medium" />

    <EditText
        android:id="@+id/etSubjectDesc"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginTop="@dimen/space_12"
        android:background="@drawable/bg_quiz_option_default"
        android:gravity="top|start"
        android:hint="Mô tả môn học (tùy chọn)"
        android:padding="@dimen/space_12"
        android:textColor="@color/color_text_primary"
        android:textSize="@dimen/text_body_medium" />
</LinearLayout>
